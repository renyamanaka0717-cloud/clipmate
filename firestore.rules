rules_version = '2';

// Spark plan (free): Auth + Firestore only
// These rules keep read/write access scoped to authenticated users
// and prevent unauthorized access without requiring paid features.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Users: authenticated read; own write only
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Lists: authenticated users can read and create;
    // only the owner can update/delete
    match /lists/{listId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // List Members: authenticated read/create;
    // only member themselves or list owner can delete
    match /listMembers/{memberId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.role == 'owner'
      );
    }

    // Items: any authenticated user can read and create;
    // only the adder can update/delete their own items
    match /items/{itemId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAuth() && resource.data.addedBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.addedBy == request.auth.uid;
    }

    // Comments: authenticated read/create; own delete only
    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Reactions: authenticated read; own write/delete only
    match /reactions/{reactionId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Invitations: authenticated read; creator can delete
    match /invitations/{invId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }
  }
}
